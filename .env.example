# Core bot settings
BOT_NAME=QQBot
BOT_NICKNAME=
SUPERUSERS=
COMMAND_START=/
BOT_TIMEZONE=
ALLOWED_GROUPS=
BLOCKED_GROUPS=
LOG_LEVEL=INFO

# NoneBot / OneBot 11
DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
ONEBOT_ACCESS_TOKEN=

# NapCat account selection, optional login fallback, and WebUI bootstrap secret
NAPCAT_ACCOUNT=
NAPCAT_QUICK_PASSWORD_MD5=
NAPCAT_WEBUI_TOKEN=
APP_UID=1000
APP_GID=1000
NAPCAT_UID=1000
NAPCAT_GID=1000
NAPCAT_IMAGE=mlikiowa/napcat-docker:v4.18.19@sha256:1336a777f9a4f1f8cb89fef42f7548deacd3645919a067a50df5b66b5e77390e

# SQLite
DATABASE_PATH=/app/data/bot.db

# AI remains safe-off until a provider is configured
AI_ENABLED=false
AI_PRIVATE_MODE=all
AI_GROUP_MODE=mention
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_HISTORY_MESSAGES=24
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_REPLY_CHARS=3000
AI_COOLDOWN_SECONDS=2
AI_MAX_CONCURRENCY=5
AI_SUMMARY_TRIGGER_MESSAGES=24
AI_SUMMARY_KEEP_RECENT_MESSAGES=8
AI_SUMMARY_MAX_CHARS=3000
AI_SKILLS_MAX_TOTAL_CHARS=12000
